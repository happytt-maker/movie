# 统一换行符：仓库内一律存 LF，检出时按平台转换
# 这样 Windows 本地与教师端的 Linux 环境看到的内容一致，diff 不会因 CRLF 抖动
* text=auto

*.py    text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.txt   text eol=lf
*.csv   text eol=lf
*.json  text eol=lf
*.sh    text eol=lf

# Windows 批处理保留 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制文件不做转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.zip   binary
*.parquet binary
*.pkl   binary
*.pt    binary
*.npz   binary
*.docx  binary
*.pptx  binary
*.xlsx  binary

# —— GitHub 语言统计：生成物与文档不计入语言占比 ——
# 否则仓库首页会显示成 "CSV 99%"，掩盖真实的 Python 代码量
results/*.json linguist-generated
results/*.csv  linguist-generated
data/**        linguist-vendored
docs/**        linguist-documentation
